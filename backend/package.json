{
  "name": "@hc-management/backend",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile ./dist/hcmanagement"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "@hc-management/shared": "workspace:*",
    "@hono/standard-validator": "^0.4.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "awilix": "^13.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/bun": "latest",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
