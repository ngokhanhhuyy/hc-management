{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["es2022", "esnext.decorators", "dom", "DOM.Iterable"],
    "paths": {
      "#/*": ["./src/*"],
      "#/prisma/*": ["./prisma/generated/*"]
    }
  }
}
